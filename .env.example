# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/tajwin

# JWT Configuration
JWT_SECRET=supersecretaccesskey123!
JWT_REFRESH_SECRET=supersecretrefreshkey456!

# Admin Seeding Credentials (Only used during seeding)
SEED_ADMIN_EMAIL=admin@tajwin.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
